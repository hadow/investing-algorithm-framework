[Unit]
Description=Supertrend RSI daily candidate selection (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=iaf
Group=iaf
WorkingDirectory="@PROJECT_ROOT@"
EnvironmentFile=/etc/iaf-supertrend/%i.env
ExecStartPre="@PROJECT_ROOT@/.venv/bin/python" "@PROJECT_ROOT@/examples/algorithm_examples/strategies_showcase/27_supertrend_rsi/deploy/ubuntu24/authorize.py" --env-file /etc/iaf-supertrend/%i.env --check-cache
ExecStart="@PROJECT_ROOT@/.venv/bin/python" "@PROJECT_ROOT@/examples/algorithm_examples/strategies_showcase/27_supertrend_rsi/screener.py" --directory /var/lib/iaf-supertrend/%i/selection
StateDirectory=iaf-supertrend
StateDirectoryMode=0700
TimeoutStartSec=60min
KillSignal=SIGINT
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
Nice=10
OOMScoreAdjust=300
CPUWeight=20
CPUAccounting=true
MemoryAccounting=true
MemoryHigh=256M
MemoryMax=384M
TasksMax=64
